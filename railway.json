{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "pkgs": ["openssl", "pkg-config"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "cargo run --release",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
